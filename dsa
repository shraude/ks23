from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import dsa


def generate_dsa_signature(private_key, message):
    signature = private_key.sign(message.encode("utf-8"), hashes.SHA256())
    return signature


def verify_dsa_signature(public_key, signature, message):
    try:
        public_key.verify(signature, message.encode("utf-8"), hashes.SHA256())
        print("Signature verified successfully. ")
    except InvalidSignature:
        print("Signature verified failed. ")


def generate_dsa_key_pair():
    private_key = dsa.generate_private_key(
        key_size=1024, backend=default_backend()
    )
    public_key = private_key.public_key()
    return private_key, public_key


if __name__ == "__main__":
    message = "Hello, World...!"
    private_key, public_key = generate_dsa_key_pair()
    signature = generate_dsa_signature(private_key, message)
    print("Generated DSA Signature : ", signature.hex())

    verify_dsa_signature(public_key, signature, message)
