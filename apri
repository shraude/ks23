import pandas as pd
import matplotlib.pyplot as plt
from mlxtend.preprocessing import TransactionEncoder
from mlxtend.frequent_patterns import apriori, association_rules

transactions = [
    ["Bread", "Milk", "Butter"],
    ["Bread", "Milk"],
    ["Bread", "Butter"],
    ["Milk", "Butter"],
    ["Bread", "Milk", "Butter"],
    ["Bread", "Eggs"],
    ["Milk", "Eggs"],
    ["Bread", "Milk", "Eggs"],
    ["Bread", "Butter", "Eggs"],
    ["Milk", "Butter"]
]

te = TransactionEncoder()
basket = pd.DataFrame(
    te.fit_transform(transactions),
    columns=te.columns_
)

frequent = apriori(
    basket,
    min_support=0.3,
    use_colnames=True
)

print("FREQUENT ITEMSETS")
print(frequent)

rules = association_rules(
    frequent,
    metric="confidence",
    min_threshold=0.5
)

print("\nASSOCIATION RULES")
print(rules[[
    "antecedents",
    "consequents",
    "support",
    "confidence",
    "lift"
]])

basket.mean().sort_values(ascending=False).plot(
    kind="bar",
    color="skyblue"
)

plt.title("Frequent Grocery Items")
plt.ylabel("Support")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
